# 🔧 إعدادات نظام MMHR - مثال على متغيرات البيئة
# ═══════════════════════════════════════════════════════════════════
# انسخ هذا الملف إلى .env وضع فيه قيمك الحقيقية
# cp .env.example .env
# ═══════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════
# 📊 قاعدة البيانات PostgreSQL
# ═══════════════════════════════════════════════════════════════════

# الخيار 1: رابط الاتصال الكامل (مفضل - يستخدمه Render تلقائياً)
DATABASE_URL=******HOST/DATABASE_NAME

# الخيار 2: متغيرات منفصلة (بديل إذا لم يكن DATABASE_URL متاحاً)
DB_USER=postgres
DB_HOST=localhost
DB_NAME=mmhr_db
DB_PASSWORD=your_password_here
DB_PORT=5432

# ═══════════════════════════════════════════════════════════════════
# 🔐 الأمان
# ═══════════════════════════════════════════════════════════════════

# مفتاح JWT - غير هذا إلى قيمة عشوائية طويلة في الإنتاج
JWT_SECRET=change_this_to_a_long_random_secret_key_in_production

# ═══════════════════════════════════════════════════════════════════
# 🌍 البيئة والمنفذ
# ═══════════════════════════════════════════════════════════════════

NODE_ENV=production
PORT=5000

# ═══════════════════════════════════════════════════════════════════
# 🤖 Telegram Bot
# ═══════════════════════════════════════════════════════════════════

# توكن البوت من @BotFather على Telegram
TELEGRAM_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# رابط الـ Webhook (عند النشر على Render)
TELEGRAM_WEBHOOK_URL=https://YOUR-APP-NAME.onrender.com

# ═══════════════════════════════════════════════════════════════════
# 📱 WhatsApp Bot (Twilio)
# ═══════════════════════════════════════════════════════════════════

# رقم WhatsApp المخصص للبوت (اختياري)
WHATSAPP_TOKEN=966XXXXXXXXX

# بيانات Twilio (مطلوبة لإرسال رسائل WhatsApp)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ═══════════════════════════════════════════════════════════════════
# 🔗 رابط API الداخلي
# ═══════════════════════════════════════════════════════════════════

# رابط السيرفر الرئيسي (يستخدمه البوت للتواصل مع API)
API_BASE_URL=https://YOUR-APP-NAME.onrender.com

# ═══════════════════════════════════════════════════════════════════
# 📧 البريد الإلكتروني (اختياري)
# ═══════════════════════════════════════════════════════════════════

GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# ═══════════════════════════════════════════════════════════════════
# ⚠️ تحذير أمان:
# - لا تضع هذا الملف (.env) في Git
# - أضف .env إلى .gitignore
# - غير جميع كلمات السر في الإنتاج
# ═══════════════════════════════════════════════════════════════════
