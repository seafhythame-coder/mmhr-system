# ==============================
# Core API / Server
# ==============================
NODE_ENV=production
PORT=5000
API_BASE_URL=https://your-api-service.onrender.com
JWT_SECRET=replace_with_strong_secret

# Prefer DATABASE_URL on Render PostgreSQL
DATABASE_URL=******host:5432/database

# Optional local DB fallback
DB_USER=postgres
DB_HOST=localhost
DB_NAME=mmhr_db
DB_PASSWORD=postgres
DB_PORT=5432

# ==============================
# Telegram Bot
# ==============================
TELEGRAM_BOT_TOKEN=replace_with_telegram_bot_token

# ==============================
# WhatsApp Bot (Twilio)
# ==============================
TWILIO_ACCOUNT_SID=replace_with_twilio_account_sid
TWILIO_AUTH_TOKEN=replace_with_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# Optional alias names supported by code:
WHATSAPP_ACCOUNT_SID=replace_with_twilio_account_sid
WHATSAPP_TOKEN=replace_with_twilio_auth_token
WHATSAPP_PHONE_NUMBER=whatsapp:+14155238886
WHATSAPP_PORT=3001
