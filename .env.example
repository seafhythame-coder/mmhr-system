# 🔧 إعدادات نظام MMHR - نسخة للتجربة
# ═══════════════════════════════════════════════════════════════════
# انسخ هذا الملف إلى .env وعدّل القيم

# 🤖 Telegram Bot Token (احصل عليه من @BotFather على تليجرام)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 🔐 مفتاح الأمان (يمكن تركه كما هو للتجربة)
JWT_SECRET=mmhr_secret_key_2026_super_secure_key_change_this
PORT=5000

# 🌍 البيئة
NODE_ENV=development

# 🌐 رابط API
API_BASE_URL=http://localhost:5000
