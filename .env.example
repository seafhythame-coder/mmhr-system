# 🔧 إعدادات نظام MMHR - مثال
# ═══════════════════════════════════════════════════════════════════
# انسخ هذا الملف إلى .env وعدّل القيم
# cp .env.example .env
# ═══════════════════════════════════════════════════════════════════

# ══════════════════════════════════
# 🤖 بوت Telegram (مطلوب للـ quick-start)
# ══════════════════════════════════
# احصل على التوكن من @BotFather في تليجرام
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# ══════════════════════════════════
# 📱 بوت WhatsApp (اختياري - يحتاج Twilio)
# ══════════════════════════════════
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ══════════════════════════════════
# 📊 قاعدة البيانات PostgreSQL (اختياري)
# مطلوب فقط لـ npm start أو npm run bots
# ══════════════════════════════════
DB_USER=postgres
DB_HOST=localhost
DB_NAME=mmhr_db
DB_PASSWORD=your_password_here
DB_PORT=5432

# ══════════════════════════════════
# 🔐 الأمان
# ══════════════════════════════════
JWT_SECRET=change_this_to_a_random_secret_key_min_32_chars
PORT=5000

# ══════════════════════════════════
# 🌍 البيئة
# ══════════════════════════════════
NODE_ENV=development

# ══════════════════════════════════
# 🌐 عنوان API الرئيسي (للبوتات المتقدمة)
# ══════════════════════════════════
API_BASE_URL=http://localhost:5000

# ══════════════════════════════════
# 🤖 OpenAI (اختياري)
# ══════════════════════════════════
OPENAI_API_KEY=sk-your_openai_key_here

# ═══════════════════════════════════════════════════════════════════
# ⚠️ تنبيه أمان:
# - لا تضع هذا الملف في Git إذا كانت فيه مفاتيح حقيقية
# - .env.example يمكن وضعه في Git (بدون قيم حقيقية)
# ═══════════════════════════════════════════════════════════════════
