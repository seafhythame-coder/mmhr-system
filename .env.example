# ═══════════════════════════════════════════════════════════════════
# 🔧 متغيرات البيئة - نظام MMHR
# انسخ هذا الملف إلى .env واملأ القيم الحقيقية
# ═══════════════════════════════════════════════════════════════════

# ─── قاعدة البيانات PostgreSQL (Render) ─────────────────────────────
# استخدم DATABASE_URL إذا كنت على Render (يُغني عن المتغيرات المنفصلة أدناه)
DATABASE_URL=******HOST/DATABASE

# أو استخدم المتغيرات المنفصلة (للتطوير المحلي)
DB_USER=postgres
DB_HOST=localhost
DB_NAME=mmhr_db
DB_PASSWORD=your_password_here
DB_PORT=5432

# ─── الأمان ──────────────────────────────────────────────────────────
JWT_SECRET=mmhr_secret_key_2026_super_secure_change_this_in_production
PORT=5000
NODE_ENV=production

# ─── بوت Telegram ────────────────────────────────────────────────────
# احصل على التوكن من @BotFather على Telegram
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
API_BASE_URL=https://YOUR_APP_NAME.onrender.com

# ─── بوت WhatsApp (Twilio) ────────────────────────────────────────────
# سجّل حساباً على https://www.twilio.com للحصول على هذه البيانات
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ─── APIs اختيارية ───────────────────────────────────────────────────
OPENAI_API_KEY=sk-your_openai_key_here

# ═══════════════════════════════════════════════════════════════════
# ⚠️  إرشادات الأمان:
#   1. لا تضع هذا الملف (.env) في Git
#   2. على Render: أضف المتغيرات في لوحة التحكم > Environment
#   3. غيّر JWT_SECRET في بيئة الإنتاج
# ═══════════════════════════════════════════════════════════════════
