# 🔧 إعدادات نظام MMHR (للتطوير المحلي فقط)
# ═══════════════════════════════════════════════════════════════════
# ⚠️ على Render: أضف المتغيرات في لوحة التحكم وليس هنا

# 📊 قاعدة البيانات PostgreSQL
# استخدم DATABASE_URL للاتصال بـ Render أو أي PostgreSQL خارجي
DATABASE_URL=******HOST/DATABASE

# أو المتغيرات المنفصلة (للتطوير المحلي)
DB_USER=postgres
DB_HOST=localhost
DB_NAME=mmhr_db
DB_PASSWORD=secure_password_here
DB_PORT=5432

# 🔐 الأمان
JWT_SECRET=mmhr_secret_key_2026_super_secure_key_change_this
PORT=5000

# 🌍 البيئة
NODE_ENV=development

# 🤖 Telegram Bot
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
API_BASE_URL=http://localhost:5000

# 📱 WhatsApp (Twilio)
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# 🤖 API (اختياري)
OPENAI_API_KEY=sk-your_openai_key_here

