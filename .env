# 🔧 إعدادات نظام MMHR
# ═══════════════════════════════════════════════════════════════════

# 🤖 بوت Telegram (مطلوب لـ quick-start)
# احصل على التوكن من @BotFather في تليجرام
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# 📱 بوت WhatsApp (اختياري - يحتاج Twilio)
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# 📊 قاعدة البيانات PostgreSQL (مطلوب لـ npm start فقط)
DB_USER=postgres
DB_HOST=localhost
DB_NAME=mmhr_db
DB_PASSWORD=secure_password_here
DB_PORT=5432

# 🔐 الأمان
JWT_SECRET=mmhr_secret_key_2026_super_secure_key_change_this
PORT=5000

# 🌍 البيئة
NODE_ENV=development

# 🌐 عنوان API الرئيسي
API_BASE_URL=http://localhost:5000

# 🤖 OpenAI (اختياري)
OPENAI_API_KEY=sk-your_openai_key_here

