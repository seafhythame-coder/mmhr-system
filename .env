# 🔧 إعدادات نظام MMHR
# ═══════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════
# 🚀 RENDER (الإنتاج) — استخدم هذا عند النشر على Render
# ═══════════════════════════════════════════════════════════════════
# DATABASE_URL=******host/dbname  ← من لوحة تحكم Render

# ═══════════════════════════════════════════════════════════════════
# 🖥️ محلي (التطوير) — استخدم هذا عند التشغيل محلياً
# ═══════════════════════════════════════════════════════════════════
DB_USER=postgres
DB_HOST=localhost
DB_NAME=mmhr_db
DB_PASSWORD=secure_password_here
DB_PORT=5432

# 🔐 الأمان
JWT_SECRET=mmhr_secret_key_2026_super_secure_key_change_this
PORT=5000

# 🌍 البيئة
NODE_ENV=development

# 🤖 Telegram Bot
# TELEGRAM_TOKEN=1234567890:AAFxxxYYYzzz  ← من @BotFather على Telegram
# TELEGRAM_WEBHOOK_URL=https://اسم-مشروعك.onrender.com  ← رابط خدمتك على Render (اختياري)

# 📱 WhatsApp Bot (Twilio) — اختياري
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# 🔑 بريد إلكتروني (اختياري)
# GMAIL_USER=your-email@gmail.com
# GMAIL_PASSWORD=your-app-password

# 🤖 API (اختياري)
OPENAI_API_KEY=sk-your_openai_key_here

# ═══════════════════════════════════════════════════════════════════
# ⚠️ تحذير أمان:
# - غير كلمات السر في الإنتاج
# - لا تضع المفاتيح الحقيقية في Git
# - استخدم متغيرات البيئة في Render Settings
# ═══════════════════════════════════════════════════════════════════
