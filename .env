# 🔧 إعدادات نظام MMHR
# ═══════════════════════════════════════════════════════════════════

# 📊 قاعدة البيانات PostgreSQL
# استخدم DATABASE_URL إذا كنت على Render أو Heroku أو Railway
# DATABASE_URL=******host/dbname
# أو استخدم الإعدادات المنفصلة:
DB_USER=postgres
DB_HOST=localhost
DB_NAME=mmhr_db
DB_PASSWORD=secure_password_here
DB_PORT=5432

# 🔐 الأمان
JWT_SECRET=mmhr_secret_key_2026_super_secure_key_change_this
PORT=5000

# 🌍 البيئة
NODE_ENV=development

# 🤖 بوت Telegram
# TELEGRAM_TOKEN=your_telegram_bot_token_here

# 📱 بوت WhatsApp عبر Twilio (اختياري)
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# 🌐 عنوان API الداخلي (يستخدمه البوت للتواصل مع السيرفر)
# API_BASE_URL=http://localhost:5000

# 🤖 API (اختياري)
# OPENAI_API_KEY=sk-your_openai_key_here

